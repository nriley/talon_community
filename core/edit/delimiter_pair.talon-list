list: user.delimiter_pair
-

# Format:
# SPOKEN_FORM: LEFT_DELIMITER RIGHT_DELIMITER
# Use the literal symbols for delimiters (except for whitespace, which is "space")
#
# Examples:
# round: ( )
# pad: space space

round: ( )
args: ( )
box: [ ]
diamond: < >
curly: { }
quotes: "' '"
dubquotes: '" "'
skis: ` `
percents: % %
pad: space space

escaped dubquotes: '\\" \\"'
escaped quotes:  "\\' \\'"
escaped args: \( \)
escaped box: \[ \]
